---
import { phone } from "../data/site";
interface Props { tone?: "light" | "petrol"; size?: "md" | "lg"; label?: string; showNumber?: boolean; class?: string; }
const { tone = "light", size = "md", label = "Подзвонити лікарю", showNumber = false, class: cls } = Astro.props;
---
<a class:list={["call", `call--${tone}`, `call--${size}`, cls]} href={`tel:${phone.tel}`}>
  <svg class="call__icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 4h3.2l1.6 4-2 1.3a11 11 0 0 0 5.9 5.9l1.3-2 4 1.6V18a2 2 0 0 1-2 2A15 15 0 0 1 3 6a2 2 0 0 1 2-2Z"/></svg>
  <span>{showNumber ? phone.text : label}</span>
  {showNumber && <span class="visually-hidden">— {label.toLowerCase()}</span>}
</a>
